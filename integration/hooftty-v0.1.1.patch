diff --git a/kernel/drivers/graphics.c b/kernel/drivers/graphics.c
new file mode 100644
index 0000000..c87b737
--- /dev/null
+++ b/kernel/drivers/graphics.c
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <kernseed/graphics.h>
+#include <kernseed/pixels.h>
+#include <kernseed/console.h>
+#include <kernseed/keyboard.h>
+#include <kernseed/io.h>
+#include <kernseed/scheduler.h>
+bool graphics_owned;
+static unsigned width,height,buttons,part;
+static int mx,my;
+static uint8_t packet[3];
+static uint8_t master_mask,slave_mask,controller;
+static bool ready;
+static uint64_t events[64];
+static unsigned head,tail;
+static uint64_t snapshot(void){return (unsigned)mx|((uint64_t)(unsigned)my<<16)|((uint64_t)buttons<<32);}
+static void queue(void){
+    uint64_t e=snapshot();
+    unsigned last=(head+63)%64;
+    if(head!=tail && (events[last]>>32)==(e>>32)){events[last]=e;return;}
+    unsigned next=(head+1)%64;
+    if(next==tail)tail=(tail+1)%64; /* bounded overflow: retain newest state */
+    events[head]=e;head=next;
+}
+static bool wait_in(void){for(unsigned i=0;i<100000;i++)if(!(inb(0x64)&2))return true;return false;}
+static bool cmd(uint8_t c){if(!wait_in())return false;outb(0x64,c);return true;}
+static bool aux(uint8_t c){
+    if(!cmd(0xd4)||!wait_in())return false;
+    outb(0x60,c);
+    for(unsigned i=0;i<100000;i++){
+        unsigned s=inb(0x64);
+        if(s&1){unsigned b=inb(0x60);if(s&0x20)return !(s&0xc0)&&b==0xfa;}
+    }
+    return false;
+}
+void mouse_byte(uint8_t b){
+    if(!graphics_owned)return;
+    if(!part&&!(b&8))return;
+    packet[part++]=b;if(part<3)return;part=0;
+    if(packet[0]&0xc0)return; /* overflow: discard the whole packet */
+    int dx=(int)packet[1]-((packet[0]&0x10)?256:0);
+    int dy=(int)packet[2]-((packet[0]&0x20)?256:0);
+    mx+=dx;my-=dy;
+    if(mx<0)mx=0;
+    if(my<0)my=0;
+    if(mx>=(int)width)mx=(int)width-1;
+    if(my>=(int)height)my=(int)height-1;
+    buttons=packet[0]&7;queue();
+}
+long graphics_open(void){
+    if(graphics_owned)return -16;
+    uint64_t size=pixels_size();width=size&65535;height=(size>>16)&65535;
+    if(width<400||height<300)return -19;
+    /* Syscalls enter with IF clear. IRQ1/IRQ12 share the i8042 drain path. */
+    if(!cmd(0xa8))return -19;
+    if(!aux(0xf6)||!aux(0xe6)||!aux(0xf3)||!aux(200)||!aux(0xf4)){cmd(0xa7);return -19;}
+    head=tail=0;mx=width/2;my=height/2;buttons=part=0;
+    while(keyboard_getchar()!=-1){}
+    /* Enable AUX IRQ delivery while the session owns the shared port. */
+    cmd(0xa7);keyboard_poll();
+    if(!cmd(0x20))return -19;
+    int config=-1;for(unsigned i=0;i<100000;i++)if(inb(0x64)&1){config=inb(0x60);break;}
+    if(config<0 || !cmd(0x60)||!wait_in())return -19;
+    controller=(uint8_t)config;outb(0x60,(controller|2)&~0x20);
+    master_mask=inb(0x21);slave_mask=inb(0xa1);
+    graphics_owned=ready=true;pixels_pause(true);
+    outb(0x21,master_mask&~4);outb(0xa1,slave_mask&~16);cmd(0xa8);
+    return (long)size;
+}
+void graphics_close(void){
+    if(!graphics_owned)return;
+    pixels_end();cmd(0xa7);
+    outb(0x21,master_mask);outb(0xa1,slave_mask);keyboard_poll();
+    if(cmd(0x60)&&wait_in())outb(0x60,controller);
+    ready=graphics_owned=false;pixels_pause(false);part=buttons=0;
+    /* Drain pending AUX bytes without discarding keyboard state. */
+    keyboard_poll();while(keyboard_getchar()!=-1){}
+    framebuffer_clear();
+}
+long graphics_draw(uint64_t b,uint64_t c,bool glyph){
+    if(!graphics_owned)return -1;
+    unsigned x=b&65535,y=(b>>16)&65535,w=(b>>32)&65535,h=b>>48;
+    if(glyph)pixels_glyph(x,y,c&255,(c>>8)&0xffffff);
+    else pixels_rect(x,y,w,h,c&0xffffff);
+    return 0;
+}
+long graphics_input(void){
+    if(!ready)return -1;
+    if(head==tail)task_sleep(1); /* sleep BEFORE sampling; never return a stale sample */
+    keyboard_poll();
+    uint64_t event=snapshot();
+    if(head!=tail){event=events[tail];tail=(tail+1)%64;}
+    int key=keyboard_getchar();
+    return (long)(event|((uint64_t)(key<0?0:key)<<40));
+}
