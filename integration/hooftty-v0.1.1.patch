@@ -2,6 +2,9 @@
 #include <kernseed/console.h>
 #include <limine.h>
 #include <stddef.h>
+#include <stdbool.h>
+static bool display_paused;
+#include <kernseed/pixels.h>
 
 /* Original 5x7 bitmap alphabet. Lowercase is displayed as uppercase.
  * Each row occupies five low bits, leftmost pixel in bit 4. No font dependency. */
@@ -68,7 +71,35 @@ static uint64_t column, row;
 static uint32_t foreground;
 enum { CELL_W = 12, CELL_H = 18 };
 
+static uint32_t shadow[1024*768];
+static bool buffered;
+static unsigned left,top,right,bottom;
+long pixels_begin(void){
+    if(!screen || screen->width>1024 || screen->height>768)return -19;
+    if(buffered)return -16;
+    for(unsigned y=0;y<screen->height;y++)for(unsigned x=0;x<screen->width;x++)
+        shadow[y*1024+x]=*(volatile uint32_t *)((uint8_t *)screen->address+y*screen->pitch+x*4);
+    left=1024;top=768;right=bottom=0;buffered=true;return 0;
+}
+void pixels_end(void){buffered=false;}
+long pixels_present(void){
+    if(!buffered)return -1;
+    for(unsigned y=top;y<bottom;y++)for(unsigned x=left;x<right;x++){
+        volatile uint32_t *dst=(volatile uint32_t *)((uint8_t *)screen->address+y*screen->pitch+x*4);
+        uint32_t c=shadow[y*1024+x];if(*dst!=c)*dst=c;
+    }
+    left=1024;top=768;right=bottom=0;return 0;
+}
 static void pixel(uint64_t x, uint64_t y, uint32_t color) {
+    if(buffered){
+        if(shadow[y*1024+x]==color)return;
+        shadow[y*1024+x]=color;
+        if(x<left)left=x;
+        if(y<top)top=y;
+        if(x+1>right)right=x+1;
+        if(y+1>bottom)bottom=y+1;
+        return;
+    }
     volatile uint32_t *p = (volatile uint32_t *)((uint8_t *)screen->address
                                                + y * screen->pitch + x * 4);
     *p = color;
@@ -95,7 +126,7 @@ bool framebuffer_init(struct limine_framebuffer *fb) {
     return true;
 }
 void framebuffer_putc(char c) {
-    if (!screen) return;
+    if (!screen || display_paused) return;
     if (c == '\r') { column = 0; return; }
     if (c == '\n') { column = 0; ++row; }
     else {
@@ -204,3 +235,24 @@ void framebuffer_draw_sprite(
     }
 }
 
+
+/* Bounded graphics primitives; no framebuffer address is exported to users. */
+uint64_t pixels_size(void){return screen ? screen->width | (screen->height<<16) : 0;}
+static uint32_t native_rgb(uint32_t c){
+    return ((c>>16)&255)<<screen->red_mask_shift |
+           ((c>>8)&255)<<screen->green_mask_shift | (c&255)<<screen->blue_mask_shift;
+}
+void pixels_rect(unsigned x,unsigned y,unsigned w,unsigned h,uint32_t rgb){
+    if(!screen || x>=screen->width || y>=screen->height)return;
+    if(w>screen->width-x)w=screen->width-x;
+    if(h>screen->height-y)h=screen->height-y;
+    uint32_t c=native_rgb(rgb);
+    for(unsigned j=0;j<h;j++)for(unsigned i=0;i<w;i++)pixel(x+i,y+j,c);
+}
+void pixels_glyph(unsigned x,unsigned y,unsigned c,uint32_t rgb){
+    if(c>=128)return;
+    for(unsigned j=0;j<7;j++)for(unsigned i=0;i<5;i++)
+        if(font[c][j]&(1U<<(4-i)))pixels_rect(x+i*2,y+j*2,2,2,rgb);
+}
+
+void pixels_pause(bool paused){display_paused=paused;}
