diff --git a/kernel/drivers/framebuffer.c b/kernel/drivers/framebuffer.c
index 622953d..294b779 100644
--- a/kernel/drivers/framebuffer.c
+++ b/kernel/drivers/framebuffer.c
@@ -2,6 +2,9 @@
 #include <kernseed/console.h>
 #include <limine.h>
 #include <stddef.h>
+#include <stdbool.h>
+static bool display_paused;
+#include <kernseed/pixels.h>
 
 /* Original 5x7 bitmap alphabet. Lowercase is displayed as uppercase.
  * Each row occupies five low bits, leftmost pixel in bit 4. No font dependency. */
@@ -95,7 +98,7 @@ bool framebuffer_init(struct limine_framebuffer *fb) {
     return true;
 }
 void framebuffer_putc(char c) {
-    if (!screen) return;
+    if (!screen || display_paused) return;
     if (c == '\r') { column = 0; return; }
     if (c == '\n') { column = 0; ++row; }
     else {
@@ -204,3 +207,24 @@ void framebuffer_draw_sprite(
     }
 }
 
+
+/* Bounded graphics primitives; no framebuffer address is exported to users. */
+uint64_t pixels_size(void){return screen ? screen->width | (screen->height<<16) : 0;}
+static uint32_t native_rgb(uint32_t c){
+    return ((c>>16)&255)<<screen->red_mask_shift |
+           ((c>>8)&255)<<screen->green_mask_shift | (c&255)<<screen->blue_mask_shift;
+}
+void pixels_rect(unsigned x,unsigned y,unsigned w,unsigned h,uint32_t rgb){
+    if(!screen || x>=screen->width || y>=screen->height)return;
+    if(w>screen->width-x)w=screen->width-x;
+    if(h>screen->height-y)h=screen->height-y;
+    uint32_t c=native_rgb(rgb);
+    for(unsigned j=0;j<h;j++)for(unsigned i=0;i<w;i++)pixel(x+i,y+j,c);
+}
+void pixels_glyph(unsigned x,unsigned y,unsigned c,uint32_t rgb){
+    if(c>=128)return;
+    for(unsigned j=0;j<7;j++)for(unsigned i=0;i<5;i++)
+        if(font[c][j]&(1U<<(4-i)))pixels_rect(x+i*2,y+j*2,2,2,rgb);
+}
+
+void pixels_pause(bool paused){display_paused=paused;}
